# .gitignore
# ローカルの秘密情報と永続データをコミットしない。
.env
.env.acceptance
var/data/
var/phpstan/
var/*.sqlite
*.sqlite-wal
*.sqlite-shm
backups/
var/acceptance/tls/
vendor/

# テスト・復元・エディタが生成する一時ファイルをコミット対象外にする。
.tmp/
tmp/
temp/
coverage/
.phpunit.cache/
.phpunit.result.cache
*.tmp
*.temp
*.bak
*.swp
*~
*.restore.*
*.pre-restore.*
