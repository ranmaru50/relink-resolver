# .env.acceptance.example
# Testbed 受入専用の例。実際のパスワードへ置き換え、.env.acceptance はコミットしない。
RELINK_ENV=acceptance
RELINK_ADMIN_USERNAME=acceptance-admin
RELINK_ADMIN_PASSWORD=replace-with-a-local-test-secret
RELINK_ADMIN_ALLOW_HTTP=0
RELINK_CACHE_MAX_AGE=60
RELINK_SERVICE_PREFIX=/relink
RELINK_OUTBOUND_ALLOWED_CIDRS=
RELINK_OUTBOUND_DENIED_CIDRS=
