# .env.example
# 本番パスワードはここへ記載せず、Secret 管理から注入する。
RELINK_ENV=development
RELINK_ADMIN_USERNAME=admin
RELINK_ADMIN_PASSWORD=change-me
# 同一クライアント IP に対する失敗回数、集計窓、ロック時間（秒）。
RELINK_ADMIN_LOGIN_MAX_FAILURES=5
RELINK_ADMIN_LOGIN_WINDOW_SECONDS=900
RELINK_ADMIN_LOGIN_LOCKOUT_SECONDS=900
# 管理ブラウザーセッションのアイドル／絶対有効期限（秒）。
RELINK_ADMIN_SESSION_IDLE_SECONDS=900
RELINK_ADMIN_SESSION_ABSOLUTE_SECONDS=28800
RELINK_ADMIN_ALLOW_HTTP=0
# TLS 終端プロキシを使う場合のみ、プロキシの送信元 IP/CIDR を指定する。
# プロキシは X-Forwarded-Proto をクライアント入力から上書きすること。
RELINK_TRUSTED_PROXY_CIDRS=
RELINK_DATA_DIR_MODE=770
RELINK_DB_MODE=660
# Nativeでサービスユーザーがwww-data以外の場合のみ指定する。
RELINK_SERVICE_USER=www-data
RELINK_SERVICE_UID=
RELINK_SERVICE_GID=
RELINK_CACHE_MAX_AGE=60
# L2 公開 Record 応答の deployment bound（秒）。Cache-Control は
# min(deployment bound, expiresAt(G) - now) で計算される（§14.2）。
RELINK_L2_MAX_AGE=600
# L2 statement ルート（§6.1）の snapshot freshness bound W（秒、§11.4 maxSnapshotAge）。
RELINK_L2_SNAPSHOT_MAX_AGE=600
RELINK_SERVICE_PREFIX=/relink
# 管理 outbound fetch の接続先ポリシー。空の許可リストは配備側の制御に委ねる。
RELINK_OUTBOUND_ALLOWED_CIDRS=
RELINK_OUTBOUND_DENIED_CIDRS=
RELINK_OUTBOUND_MAX_REDIRECTS=5
RELINK_OUTBOUND_MAX_BODY_BYTES=8388608
RELINK_OUTBOUND_CONNECT_TIMEOUT=5
RELINK_OUTBOUND_READ_TIMEOUT=10
