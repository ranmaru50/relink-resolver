# .env.example
# 本番パスワードはここへ記載せず、Secret 管理から注入する。
RELINK_ENV=development
RELINK_ADMIN_USERNAME=admin
RELINK_ADMIN_PASSWORD=change-me
RELINK_ADMIN_ALLOW_HTTP=0
# TLS 終端プロキシを使う場合のみ、プロキシの送信元 IP/CIDR を指定する。
# プロキシは X-Forwarded-Proto をクライアント入力から上書きすること。
RELINK_TRUSTED_PROXY_CIDRS=
RELINK_DATA_DIR_MODE=770
RELINK_DB_MODE=660
# Nativeでサービスユーザーがwww-data以外の場合のみ指定する。
RELINK_SERVICE_USER=www-data
RELINK_SERVICE_UID=
RELINK_SERVICE_GID=
RELINK_CACHE_MAX_AGE=60
RELINK_SERVICE_PREFIX=/relink
