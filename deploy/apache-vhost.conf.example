# deploy/apache-vhost.conf.example
# TLS 終端済みまたは Apache 自身で TLS を終端する Native profile の例。
# VirtualHost 外の設定は server config として読み込む。
ServerTokens Prod
ServerSignature Off
TraceEnable Off
Header always set X-Content-Type-Options "nosniff"
# Container profileと同じ本文、ヘッダー、低速接続の上限をNativeでも適用する。
LimitRequestBody 65536
LimitRequestFields 50
LimitRequestFieldSize 8190
RequestReadTimeout header=10-20,MinRate=500 body=10,MinRate=500
ErrorDocument 400 "要求が不正です。"
ErrorDocument 413 "要求が大きすぎます。"

<VirtualHost *:443>
    ServerName resolver.example
    DocumentRoot /var/www/relink-resolver/public
    <Directory /var/www/relink-resolver/public>
        AllowOverride All
        Require all granted
    </Directory>
    # 管理面はネットワーク側のアクセス制御と HTTPS を必須にする。
    <Files "admin.php">
        Require ip 127.0.0.1 10.0.0.0/8
    </Files>
    # HTTPS の本番 origin だけで HSTS を有効にする。HTTP VirtualHost には設定しない。
    Header always set Strict-Transport-Security "max-age=31536000"
</VirtualHost>
