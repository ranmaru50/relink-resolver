{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "RELink Manifest 0.1 JSON Schema — frozen with Manifest 0.1 on 2026-08-31. Normative semantic conformance is defined by manifest-0.1.md; semantic changes require a later Manifest version or separately versioned profile.",
  "title": "RELink Manifest 0.1",
  "type": "object",
  "required": [
    "manifestVersion",
    "anchor",
    "entity",
    "description",
    "lifecycle"
  ],
  "properties": {
    "manifestVersion": {
      "const": "0.1"
    },
    "anchor": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "description": {
      "type": "object",
      "required": ["location"],
      "properties": {
        "location": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": "object",
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]+$",
              "minLength": 2
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "algorithm": {
                    "const": "sha-256"
                  }
                },
                "required": ["algorithm"]
              },
              "then": {
                "properties": {
                  "digest": {
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["active", "suspended", "retired"]
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
